[Unit]
Description=n3n-be edge process, on %I
Documentation=man:n3n-be-edge(8)
After=network-online.target nfw.target
Wants=network-online.target

[Service]
# n3n-be tells systemd when it is up, how it is doing (systemctl status) and
# that its main loop still runs; see docs/configure/Systemd.md
Type=notify
NotifyAccess=main
WatchdogSec=60
# The edge starts as root, for its device, its addresses and routes, and
# then runs as the user n3n-be (daemon.userid), with one of root's rights
# kept: CAP_NET_ADMIN, for tuntap.route_all and to take back what it set up
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
# its session directory, for the management socket: /run/n3n-be/SESSION
RuntimeDirectory=n3n-be/%i
# The sandbox around it, see docs/configure/Systemd.md ("The sandbox"):
# what it does not need, it cannot do either - if it were taken over
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# its own sandbox too (Landlock), which systemd's filter lets through
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
ExecStartPre=
ExecStart=/usr/sbin/n3n-be-edge start %i
# reads the configuration again: what can change while running changes,
# see docs/configure/ConfigurationFiles.md
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=multi-user.target
Alias=
