[Unit]
Description=n3n-be supernode process
Documentation=man:n3n-be-supernode(8)
After=network-online.target
Wants=network-online.target

[Service]
# n3n-be tells systemd when it is up, how it is doing (systemctl status) and
# that its main loop still runs; see docs/configure/Systemd.md
Type=notify
NotifyAccess=main
WatchdogSec=60
User=n3n-be
Group=n3n-be
# ports below 1024 too - a TCP port 443 or 80 for edges behind firewalls
# that let only the web through - and nothing else of root's
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateDevices=yes
# its session directory, for the management socket: /run/n3n-be/supernode
RuntimeDirectory=n3n-be/supernode
# The sandbox around it, see docs/configure/Systemd.md ("The sandbox"):
# what it does not need, it cannot do either - if it were taken over
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# its own sandbox too (Landlock), which systemd's filter lets through
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
ExecStart=/usr/sbin/n3n-be-supernode start
# reads the configuration again: what can change while running changes,
# see docs/configure/ConfigurationFiles.md
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=multi-user.target
Alias=
