[Unit]
Description=n3n supernode process
Documentation=man:n3n-supernode(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=n3n
Group=n3n
# ports below 1024 too - a TCP port 443 or 80 for edges behind firewalls
# that let only the web through - and nothing else of root's
AmbientCapabilities=CAP_NET_BIND_SERVICE
RuntimeDirectory=n3n
ExecStart=/usr/sbin/n3n-supernode start
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=multi-user.target
Alias=
