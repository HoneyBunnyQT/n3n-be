# Global configuration, included in top Makefile and exported from there.
#
# @configure_command@


CONFIG_HOST=@host@
CONFIG_HOST_OS=@host_os@

CONFIG_PREFIX=@CONFIG_PREFIX@
CONFIG_DOCDIR=$(DESTDIR)@CONFIG_DOCDIR@
CONFIG_MANDIR=$(DESTDIR)@CONFIG_MANDIR@
CONFIG_RUNDIR=$(DESTDIR)@CONFIG_RUNDIR@
CONFIG_SYSTEMDDIR=$(DESTDIR)@CONFIG_SYSTEMDDIR@

# the NetworkManager plugin, nm/: yes or no, and where it goes
CONFIG_NM=@CONFIG_NM@
CONFIG_NM_GTK4=@CONFIG_NM_GTK4@
CONFIG_NM_GTK3=@CONFIG_NM_GTK3@
CONFIG_NM_LIBDIR=@CONFIG_NM_LIBDIR@
CONFIG_LIBEXECDIR=@CONFIG_LIBEXECDIR@

CONFIG_WITH_OPENSSL=@with_openssl@
CONFIG_RELAY=@enable_relay@

CC=@CC@
AR=@AR@
WINDRES=@WINDRES@
EXE=@EXE@

CFLAGS+=@CFLAGS@
LDFLAGS+=@LDFLAGS@
LDLIBS_EXTRA+=@LIBS@
# for n3n-qr only, empty when it is not built
LDLIBS_QR=@LIBS_QR@
